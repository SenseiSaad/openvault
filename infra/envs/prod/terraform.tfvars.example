# Copy to terraform.tfvars (gitignored) and edit. No secret VALUES here.
domain      = "v2.example.com"
alert_email = "you@example.com"

owner = "saad"
region = "ap-south-1"

# Exact Bedrock chat inference-profile + embedding model ARNs.
bedrock_model_arns = []

oidc_allowed_subjects = [
  "repo:REPLACE_ME/openvault:ref:refs/heads/main",
  "repo:REPLACE_ME/openvault:pull_request",
  "repo:REPLACE_ME/openvault:ref:refs/tags/v*",
  "repo:REPLACE_ME/openvault:environment:production",
  "repo:REPLACE_ME/openvault:environment:staging",
]

# Optional: only for the very first apply. CI deploys SHA tags afterwards.
initial_image_tag = "bootstrap"

daily_total_token_budget = 3000000
budget_alarm_thresholds  = [20, 35, 50, 100]

dmarc_record = "v=DMARC1; p=none; rua=mailto:postmaster@v2.example.com"
