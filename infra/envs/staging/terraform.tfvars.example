# Copy to terraform.tfvars (gitignored) and edit. No secret VALUES here.
domain      = "staging.v2.example.com"
alert_email = "you@example.com"

owner = "saad"
region = "ap-south-1"

# Leave empty to force keyword fallback in staging, or use the same ARNs as prod.
bedrock_model_arns = []

oidc_allowed_subjects = [
  "repo:REPLACE_ME/openvault:ref:refs/heads/main",
  "repo:REPLACE_ME/openvault:pull_request",
  "repo:REPLACE_ME/openvault:environment:staging",
]

initial_image_tag = "bootstrap"

daily_total_token_budget = 500000
budget_alarm_thresholds  = [10, 15]

dmarc_record = "v=DMARC1; p=none; rua=mailto:postmaster@staging.v2.example.com"
