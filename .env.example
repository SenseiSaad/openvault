# Secrets for docker compose. Copy to .env and fill in. NEVER commit .env.

SECRET_KEY=generate-a-long-random-string-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email verification gate (off until SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false
COOKIE_SECURE=false

# AI: local Ollama on the host, or paste a Gemini key for online mode
LLM_PROVIDER=ollama
LLM_URL=http://host.docker.internal:11434
GEMINI_API_KEY=

# PostgreSQL (only used with: docker compose --profile pg up -d)
POSTGRES_DB=openvault
POSTGRES_USER=openvault
POSTGRES_PASSWORD=change-me
