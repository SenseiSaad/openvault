# Secrets for docker compose. Copy to .env and fill in. NEVER commit .env.

# ── Required ──────────────────────────────────────────────────────────
SECRET_KEY=
DOMAIN=openvault.example.com

# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
ALLOW_INSECURE_HTTP=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
COOKIE_SECURE=false

# Email verification gate (off until SMTP is configured)
REQUIRE_EMAIL_VERIFICATION=false

# ── AI ────────────────────────────────────────────────────────────────
# Local Ollama on the host, or an online provider key.
LLM_PROVIDER=ollama
LLM_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AWS Bedrock (India). AWS-hosted backends can use a task role; Render is
# outside AWS and needs a backend secret. Put actual values in ignored .env or
# the hosting provider's secret store; never commit them.
BEDROCK_API_KEY=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
# Stable key for encrypting provider keys saved in the UI.
LLM_KEY_ENCRYPTION_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OpenVault <no-reply@openvault.local>

# ── PostgreSQL (only used with: docker compose --profile pg up -d) ────
# Uncomment ALL of these together, otherwise the app keeps using SQLite.
# POSTGRES_DB=openvault
# POSTGRES_USER=openvault
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db

# ── Redis (only used with: docker compose --profile redis up -d) ───────
# CACHE_URL=redis://redis:6379/0
