# Slow / flaky network tuning for pnpm installs.
# Next.js + swc + sharp are large tarballs; the default 60s fetch window
# times out on slow links, so give downloads much longer and retry.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=4
