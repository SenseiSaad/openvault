# Slow / flaky network tuning for pnpm installs.
# Next.js + swc + sharp are large tarballs; the default 60s fetch window
# times out on slow links, so give downloads much longer and retry.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=4

# REQUIRED for AWS Amplify Hosting (see AWS docs "Configuring monorepo build
# settings" -> "Configuring Turborepo and pnpm monorepo apps").
# Amplify's Next.js SSR dependency tracer does not follow pnpm's default
# symlinked node_modules/.pnpm layout, so the SSR runtime bundle ends up
# missing packages and the deployed site renders blank / 500s.
# A flat (hoisted) node_modules makes the traces resolvable.
node-linker=hoisted
