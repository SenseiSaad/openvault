# ════════════════════════════════════════════════════════════════════════════
#  OpenVault — Vercel Environment Variables Reference
#  Copy these into the Vercel Dashboard (Settings → Environment Variables)
#  for your two Vercel projects (`backend` and `frontend`).
#  NEVER commit real secrets to Git.
# ════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────
# 1. BACKEND VERCEL PROJECT (Root Directory: `backend`)
# ────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SYNC_INDEXING=true

# Reuse your existing Render SECRET_KEY and LLM_KEY_ENCRYPTION_KEY so active
# sessions and encrypted LLM keys in the database remain valid.
SECRET_KEY=
LLM_KEY_ENCRYPTION_KEY=

# Render PostgreSQL EXTERNAL connection string (must include ?sslmode=require)
DATABASE_URL=postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/openvault?sslmode=require

# Hostnames and origins (include your custom domain, Vercel domain, and Amplify domain during transition)
ALLOWED_HOSTS=api.saadops.site
CORS_ALLOWED_ORIGINS=https://openvault.saadops.site
CSRF_TRUSTED_ORIGINS=https://openvault.saadops.site,https://api.saadops.site
PUBLIC_BASE_URL=https://openvault.saadops.site

# S3 Object Storage (recommended for persistent document uploads & generated forms on Vercel)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Bedrock (India profile) + Titan V2 Embeddings
LLM_PROVIDER=bedrock
BEDROCK_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=ap-south-1
EMBED_PROVIDER=bedrock
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_API_KEY=

# Email / SES SMTP
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OpenVault <no-reply@saadops.site>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional Redis for cross-instance rate limiting (e.g. Upstash Redis)
# CACHE_URL=rediss://default:password@endpoint.upstash.io:6379

# ────────────────────────────────────────────────────────────────────────────
# 2. FRONTEND VERCEL PROJECT (Root Directory: `frontend`)
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.saadops.site
