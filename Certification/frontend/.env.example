# ---------------------------------------------------------------------------
# Certification Academy LMS frontend — public configuration only.
# Copy to .env.local. NEVER put secrets here: this file is committed and the
# browser receives every NEXT_PUBLIC_* value at build time.
# ---------------------------------------------------------------------------

# API base URL. Leave empty ("") to send same-origin requests to /api and use
# the Next.js proxy below. Set only if the API is on another origin WITHOUT a
# proxy (requires permissive CORS + SameSite=None cookies on the backend).
NEXT_PUBLIC_API_BASE_URL=

# Displayed in shells/footers.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_ENVIRONMENT=development

# --- Feature flags ----------------------------------------------------------
# The backend now implements every flagged capability. Set these to true when the
# frontend is connected to it (the bundled .env.local already does). A false flag
# renders an explicit "integration pending" boundary — never simulated data.
NEXT_PUBLIC_FEATURE_LEARNER_LEARNING=true
NEXT_PUBLIC_FEATURE_LEARNER_ASSESSMENTS=true
NEXT_PUBLIC_FEATURE_LEARNER_CERTIFICATES=true
NEXT_PUBLIC_FEATURE_STORE_CHECKOUT=true
NEXT_PUBLIC_FEATURE_PLATFORM_AUDIT_LOG=true
NEXT_PUBLIC_FEATURE_BULK_INVITATIONS=true

# --- Dev/CI proxy -----------------------------------------------------------
# Rewrite /api/* to the backend so session + CSRF cookies stay first-party.
BACKEND_PROXY=true
BACKEND_ORIGIN=http://localhost:4000

# --- End-to-end tests (Playwright) ------------------------------------------
# Where the dev/preview server under test listens (playwright webServer uses
# the same origin when E2E_BASE_URL is unset).
E2E_BASE_URL=http://127.0.0.1:3000
E2E_PORT=3000
# Real credentials for a live-backend account. Specs self-skip without them.
E2E_EMAIL=
E2E_PASSWORD=
# Role under test: super_admin | training_manager | agency_admin | learner
E2E_ROLE=learner
# Set true only with an account that belongs to at least two agencies.
E2E_MULTI_AGENCY=false