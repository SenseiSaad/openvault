# OpenVault production secrets — NAMES ONLY.
#
# This file is a template for scripts/check_env.sh and
# scripts/push_env_to_ssm.sh. It is committed; the real .env.production is
# ignored by git. Never put real values in this file.
#
#   cp .env.production.example .env.production
#   # fill the SECRETS section, then:
#   ./scripts/check_env.sh .env.production --phase preflight
#   ./scripts/push_env_to_ssm.sh staging .env.production
#
# Terraform sets every non-secret value (hosts, Redis URL, bucket, email host,
# Bedrock model/region) in infra/envs/prod/main.tf. Do not duplicate them here.

# ── Secrets (SSM SecureString) ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Filled after RDS exists: postgresql://openvault:<password>@<endpoint>:5432/openvault?sslmode=require
DATABASE_URL=
# Generate a separate key and back it up; losing it invalidates stored BYO keys.
LLM_KEY_ENCRYPTION_KEY=
# SES SMTP credentials (IAM -> SMTP credentials, not your AWS access keys).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional error tracking; leave blank to disable.
SENTRY_DSN=

# ── Optional, but leave blank on ECS ────────────────────────────────────
# The ECS task role is the Bedrock credential. Never put AWS access keys here.
BEDROCK_API_KEY=

# ── Terraform-managed plain values (do not set here) ────────────────────
# ALLOWED_HOSTS
# CORS_ALLOWED_ORIGINS
# CSRF_TRUSTED_ORIGINS
# PUBLIC_BASE_URL
# COOKIE_SECURE
# ENVIRONMENT
# REQUIRE_EMAIL_VERIFICATION
# TRUSTED_PROXY_COUNT
# LLM_PROVIDER
# BEDROCK_REGION
# BEDROCK_MODEL
# BEDROCK_EMBED_MODEL
# EMBED_PROVIDER
# EMBED_DIM
# CACHE_URL
# CELERY_BROKER_URL
# DEFAULT_FROM_EMAIL
# EMAIL_HOST
# EMAIL_PORT
# EMAIL_USE_TLS
# DATA_DIR
# MEDIA_ROOT
# AWS_STORAGE_BUCKET_NAME
# AWS_S3_REGION_NAME
# ATTENDANCE_QR_REQUIRED
# LOG_FORMAT
