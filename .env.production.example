# Production environment for docker-compose.prod.yml.
#   cp .env.production.example .env.production
#   # fill in every value marked CHANGE-ME, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# This file must never be committed. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Public hostname Caddy serves and requests a TLS certificate for.
DOMAIN=CHANGE-ME.example.com

# Django secret (CHANGE-ME) and the key that encrypts stored LLM API keys.
SECRET_KEY=
LLM_KEY_ENCRYPTION_KEY=

# PostgreSQL credentials (CHANGE-ME).
POSTGRES_DB=openvault
POSTGRES_USER=openvault
POSTGRES_PASSWORD=

# Number of gunicorn workers (2 x vCPU + 1 is a good starting point).
GUNICORN_WORKERS=3

# Require a verified email before login (needs working SMTP below).
REQUIRE_EMAIL_VERIFICATION=true

# ── Hosted LLM default ──
LLM_PROVIDER=bedrock
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
# Leave blank to use the ECS/EC2 IAM role. Paste a Bedrock API key (bearer
# token) or ACCESS_KEY_ID:SECRET_ACCESS_KEY only if running outside AWS.
BEDROCK_API_KEY=
EMBED_PROVIDER=bedrock
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ── SMTP (required when REQUIRE_EMAIL_VERIFICATION=true) ──
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@CHANGE-ME.example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OpenVault <no-reply@CHANGE-ME.example.com>

LOG_LEVEL=INFO
