# ── Secrets / environment ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
!**/.env.example
backend/.env
*credentials*.json
deploy.config

# ── Python ─────────────────────────────────────────────────────────────
backend/.venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local database + uploaded/generated files (never commit user data)
backend/db.sqlite3
backend/data/
backend/media/
backend/staticfiles/
staticfiles/

# ── Frontend ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*

# ── Tests / reports ────────────────────────────────────────────────────
test-results/
playwright-report/
blob-report/
.nyc_output/

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
# Local desktop launchers contain machine-specific absolute paths.
*.desktop

# Local dev server logs (start-dev.sh)
.dev-logs/
*.log

# Backup archives (may contain customer data)
backups/

# Terraform
.terraform/
infra/modules/**/.terraform.lock.hcl
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup
*.tfbackend
*.tfplan
tfplan
crash.log
