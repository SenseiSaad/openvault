# ── Live backend config (edit me). See .env.example for all options. ──
SECRET_KEY=dev-insecure-secret-change-me-to-a-long-random-string
DEBUG=true
ACCESS_TOKEN_MINUTES=720
DATA_DIR=./data

# ── LLM PROVIDER: ollama | openai | anthropic | gemini ──
# (Or switch it live from the in-app Settings page — no restart needed.)
LLM_PROVIDER=ollama

# 1) LOCAL model via Ollama (default). CLOUD: point LLM_URL at your EC2 IP.
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# 2) OpenAI / OpenAI-compatible — paste your key to test:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 3) Anthropic (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 4) Google Gemini:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# ── Embeddings (separate from chat; local by default) ──
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
TOP_K=4
