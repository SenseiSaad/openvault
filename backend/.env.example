# ── Backend config. Copy to ".env" and adjust. ──
SECRET_KEY=dev-insecure-secret-change-me-to-a-long-random-string
DEBUG=true
ACCESS_TOKEN_MINUTES=720
DATA_DIR=./data

# ── LLM LOCATION TOGGLE (this one line switches where the model runs) ──
# LOCAL (model on this machine via Ollama):
LLM_URL=http://localhost:11434
# CLOUD (model on your EC2): comment the line above and use:
# LLM_URL=http://YOUR-EC2-PUBLIC-IP:11434
# ───────────────────────────────────────────────────────────────────
LLM_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
TOP_K=4
