# ── Backend config. Copy to ".env" and adjust. ──
# REQUIRED: the app refuses to start without a real secret (python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
DEBUG=true
# Set to "production" on a real deployment. With DEBUG=false this makes the app
# refuse to start over plain HTTP or with a wildcard ALLOWED_HOSTS.
ENVIRONMENT=development
# Only needed for a local HTTP Docker setup. Never set this in production.
ALLOW_INSECURE_HTTP=true

# ── Sessions ──
# Access token (minutes) + refresh token (days). Cookies are HttpOnly+SameSite=Lax;
# set COOKIE_SECURE=true once you serve over HTTPS.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Require a verified email before login (needs working SMTP). Keep false locally.
REQUIRE_EMAIL_VERIFICATION=false

# Public origin of the FRONTEND — used in verification/reset email links and
# for generated-form download URLs.
PUBLIC_BASE_URL=http://localhost:3000

ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins allowed to call the API with cookies. Never enable the wildcard
# flag in production: browsers reject credentials with wildcard CORS anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF_TRUSTED_ORIGINS=https://your-domain.pk

DATA_DIR=./data
MAX_UPLOAD_SIZE=52428800

# ── Database ──
# Default: SQLite (backend/db.sqlite3) — zero-config local development.
# In Docker, compose sets SQLITE_PATH=/app/data/db.sqlite3 so the file lives
# on a persistent volume.
# Production/staging: PostgreSQL via POSTGRES_* (or DATABASE_URL).
# POSTGRES_DB=openvault
# POSTGRES_USER=openvault
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgres://user:pass@host:5432/openvault

# ── Cache / rate limiting ──
# LocMem by default (single process). Use Redis for gunicorn multi-worker:
# CACHE_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════════════
#  LLM PROVIDER  — pick ONE. This is the "one place you put your key".
#  (You can also change it live from the Settings page — companies can
#   set their own override, which takes precedence over this default.)
# ════════════════════════════════════════════════════════════════════
# LLM_PROVIDER = ollama | openai | anthropic | gemini | bedrock
LLM_PROVIDER=ollama
# Encrypts API keys saved from the Settings page. Generate once and back it up:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# If blank, a key is derived from SECRET_KEY (rotating SECRET_KEY then loses
# stored provider keys and they must be re-entered once).
LLM_KEY_ENCRYPTION_KEY=

# ── 1) LOCAL model via Ollama (default; data never leaves the server) ──
# Install Ollama, then:  ollama pull llama3.2:3b && ollama pull nomic-embed-text
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# ── 2) OpenAI, or ANY OpenAI-compatible key (vLLM, LM Studio, Groq...) ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 3) Anthropic (Claude) — no embeddings API, uses keyword search ──
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── 4) Google Gemini (data is sent to Google; see README note) ──
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── 5) AWS Bedrock (India) — use the India inference profile; AWS's service
#      terms say prompts and completions are not used to train base models.
#      On ECS/EC2, prefer a workload IAM role. Render is outside AWS, so set
#      BEDROCK_API_KEY in Render's secret environment (not in the frontend).
#      Tenant BYO auth can also be set from workspace Settings.
#      BEDROCK_API_KEY accepts either a Bedrock API key (bearer token) or
#      ACCESS_KEY_ID:SECRET_ACCESS_KEY.
#      Uses the India geographic inference profile (in.*), never the global one. ──
# BEDROCK_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=ap-south-1
# BEDROCK_API_KEY=

# ── Embeddings (kept SEPARATE so switching chat model never breaks vectors) ──
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_EMBED_MODEL=gemini-embedding-001
# Titan V2 outputs 1024-dim vectors (EMBED_PROVIDER=bedrock) — switching the
# embedding model means running: python manage.py reindex_embeddings
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

TOP_K=4

# ── Email (verification / password reset / meeting confirmations) ──
# Console backend prints emails to the server log — fine for local dev.
# For production use real SMTP, e.g. Zoho/Google Workspace:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=no-reply@your-domain.pk
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OpenVault <no-reply@openvault.local>

# ── Google Calendar (optional meeting scheduling) ──
# GOOGLE_CALENDAR_CREDENTIALS=/path/service-account.json
# GOOGLE_CALENDAR_ID=primary

# ── Attendance / strike policy ──
ATTENDANCE_MONTHLY_ABSENCE_LIMIT=3
ATTENDANCE_MAX_STRIKES=3

# ── Timezone ──
TIME_ZONE=Asia/Karachi
