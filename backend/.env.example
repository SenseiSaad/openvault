# ── Backend config. Copy to ".env" and adjust. ──
SECRET_KEY=dev-insecure-secret-change-me-to-a-long-random-string
DEBUG=true
ACCESS_TOKEN_MINUTES=720
DATA_DIR=./data

# ════════════════════════════════════════════════════════════════════
#  LLM PROVIDER  — pick ONE. This is the "one place you put your key".
#  (You can also change it live, without editing this file, from the
#   in-app Settings page — that saves into the database and overrides
#   whatever is set here.)
# ════════════════════════════════════════════════════════════════════
# LLM_PROVIDER = ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama

# ── 1) LOCAL model via Ollama (default; runs on your machine / EC2) ──
# Install Ollama, then:  ollama pull llama3.2:3b
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
# CLOUD (model on your EC2): LLM_URL=http://YOUR-EC2-PUBLIC-IP:11434

# ── 2) OpenAI, or ANY OpenAI-compatible key (vLLM, LM Studio, Groq...) ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 3) Anthropic (Claude) — no embeddings API, uses keyword search ──
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── 4) Google Gemini ──
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# ── Answer style (keeps replies short & grounded → faster, on-topic) ──
# LLM_TEMPERATURE and LLM_MAX_TOKENS are set from the Settings page /
# LLMConfig row; the values above are the fallback defaults.

# ── Embeddings (kept SEPARATE from chat so switching chat model never
#    breaks the vectors already stored). Defaults to local Ollama. ──
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# OPENAI_EMBED_MODEL=text-embedding-3-small
# GEMINI_EMBED_MODEL=text-embedding-004

TOP_K=4
